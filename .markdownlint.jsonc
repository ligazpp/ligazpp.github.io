{
  // Правила проверки .md подстроены под юридические тексты:
  // длинные абзацы, готовые фрагменты законов, разметка внутри «шапки» файла.
  // Подсвеченные проблемы — это предупреждения, а не запрет: можно работать и так.
  "default": true,

  // Длинные абзацы — норма для текстов законов
  "MD013": false,
  // В файлах есть вставки готовой HTML-разметки
  "MD033": false,
  // Файлы начинаются с текста, а не с заголовка
  "MD041": false,
  // В текстах законов встречаются одинаковые заголовки внутри одного файла
  "MD024": { "siblings_only": true },
  // Ссылки «как есть» и сокращения — не считаем ошибкой
  "MD034": false,
  "MD044": false,
  "MD059": false,
  // Акценты и списки в текстах законов
  "MD036": false,
  "MD029": { "style": "one_or_ordered" },
  // Не требуем единый стиль выделения и единый стиль таблиц
  "MD049": false,
  "MD050": false,
  "MD060": false,
  // Не требуем язык у блоков кода
  "MD040": false
}
