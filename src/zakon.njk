                        {% else %}
                            <i class="fas fa-triangle-exclamation"></i> Есть новая редакция ({{ sst.onlineRevision }})
                        {% endif %}
                    </span>
                    {% endif %}
                </div>
            </a>

            <a href="{{ laws[1].textUrl }}#pravila"
               class="grid-item">
                <div class="grid-item__icon">
                    <i class="fas {{ laws[1].icon }}"></i>
                </div>
                <div>
                    <h3 class="grid-item__title">{{ laws[1].cardTitle }}</h3>
                    <p class="grid-item__text">({{ laws[1].cardNote }})</p>
                    {% set pst = lawStatus['pravila'] %}
                    {% if pst and (pst.status == 'ok' or pst.status == 'update') %}
