            </a>

            <a href="https://www.consultant.ru/document/cons_doc_LAW_429712/"
               class="grid-item"
               target="_blank"
               rel="noopener noreferrer">
                <div class="grid-item__icon">
                    <i class="fas fa-scale-balanced"></i>
                </div>
                <div>
                    <h3 class="grid-item__title">Обзор судебной практики (2022)</h3>
