                        {% else %}
                            <i class="fas fa-triangle-exclamation"></i> Есть новая редакция ({{ tst.onlineRevision }})
                        {% endif %}
                    </span>
                    {% endif %}
                </div>
            </a>

            <a href="/zakon/657/#perechen-obmenu"
               class="grid-item">
                <div class="grid-item__icon">
                    <i class="fas fa-ban"></i>
                </div>
                <div>
                    <h3 class="grid-item__title">Перечень качественных товаров, которые не обменяют</h3>
                    <p class="grid-item__text">(утв. Постановлением Правительства РФ № 657 от 30.05.2026)</p>
                </div>
            </a>

            <a href="/zakon/657/#perechen-dlitelnogo"
               class="grid-item">
                <div class="grid-item__icon">
                    <i class="fas fa-tools"></i>
                </div>
