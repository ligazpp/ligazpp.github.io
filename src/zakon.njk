                        {% else %}
                            <i class="fas fa-triangle-exclamation"></i> Есть новая редакция ({{ pst.onlineRevision }})
                        {% endif %}
                    </span>
                    {% endif %}
                </div>
            </a>

            <a href="{{ laws[3].textUrl }}"
               class="grid-item">
                <div class="grid-item__icon">
                    <i class="fas {{ laws[3].icon }}"></i>
                </div>
                <div>
                    <h3 class="grid-item__title">{{ laws[3].cardTitle }}</h3>
                    <p class="grid-item__text">({{ laws[3].cardNote }})</p>
                    {% set tst = lawStatus['perechen-tehslozhnykh'] %}
